# Copie este arquivo para .env e preencha os valores.
# O .env NUNCA deve ser enviado ao GitHub (já está no .gitignore).

# Chave secreta do Django. Gere uma com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-secreta

# True apenas em desenvolvimento. Em produção: False.
DEBUG=True

# Domínios aceitos, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para CSRF (com https://), separadas por vírgula. Em produção:
# CSRF_TRUSTED_ORIGINS=https://seu-app.onrender.com
CSRF_TRUSTED_ORIGINS=

# Banco de dados. Vazio = SQLite local.
# Em produção, a connection string do Supabase:
# DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# DATABASE_SSL_REQUIRE=True
DATABASE_URL=
DATABASE_SSL_REQUIRE=False

# Spotify Web API (fluxo Client Credentials).
# Crie um app em https://developer.spotify.com/dashboard
# Vazio = importação desativada; o cadastro manual continua funcionando.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
